// 3. 基础 UI 组件 (UI Components)
// =```tsx

const Badge: React.FC<{ text: string; type?: 'blue' }> = ({ text, type = 'blue' }) => (
  <span className={`badge badge-${type}`}>{text}</span>
);

const StatBox: React.FC<{ value: string | number; label: string }> = ({ value, label }) => (
  <div className="stat-box">
    <div className="stat-value">{value}</div>
    <div className="stat-label">{label}</div>
  </div>
);

const WarmupBox: React.FC<{ title: string; content: string }> = ({ title, content }) => (
  <div className="warmup-box">
    <span className="warmup-title">{title}</span>
    <span className="warmup-content">{content}</span>
  </div>
);

const TargetGrid: React.FC<{ targets: Target[] }> = ({ targets }) => (
  <div className="targets-grid">
    {targets.map((t, i) => (
      <div key={i} className="target-item">
        <span className="target-val">{t.value}</span>
        <span className="target-lbl">{t.label}</span>
      </div>
    ))}
  </div>
);

const SessionBlock: React.FC<{ session: Session }> = ({ session }) => (
  <div className="session-block">
    {session.label && <span className="session-label">{session.label}</span>}
    {session.exercises.map((ex, i) => (
      <div key={i} className="exercise-row">
        <span className="ex-name">{ex.name}</span>
        <span className="ex-meta">{ex.meta}</span>
      </div>
    ))}
  </div>
);

const VariantItem: React.FC<{ variant: Variant }> = ({ variant }) => (
  <div className="variant-item">
    <span className="variant-tag">{variant.tag}</span>
    <div className="variant-title">{variant.title}</div>
    {variant.desc && <div className="variant-desc">{variant.desc}</div>}
    
    {variant.params && (
      <div className="params-list">
        {variant.params.map((p, i) => (
          <div key={i} className="param-pill">
            <span>{p.icon}</span> {p.text}
          </div>
        ))}
      </div>
    )}

    {variant.sessions && variant.sessions.map((s, i) => (
      <SessionBlock key={i} session={s} />
    ))}

    {variant.note && <div className="note-box">{variant.note}</div>}
  </div>
);

// 4. 复合组件 (Composite Components)

const RoutineCard: React.FC<{ routine: Routine }> = ({ routine }) => (
  <div className="routine-card">
    <div className="card-header">
      <div className="card-icon">{routine.icon}</div>
      <h3>{routine.title}</h3>
    </div>
    
    {routine.warmup && <WarmupBox {...routine.warmup} />}
    {routine.targets && <TargetGrid targets={routine.targets} />}
    
    <div className="variant-container">
      {routine.variants.map((v, i) => (
        <VariantItem key={i} variant={v} />
      ))}
    </div>
  </div>
);

